diff --git a/shelby_volume.go b/shelby_volume.go
new file mode 100644
index 0000000..0d7a927
--- /dev/null
+++ b/shelby_volume.go
@@ -0,0 +1,65 @@
+// ABOUTME: Keeps the player volume across restarts in a small file (snd_shelby builds)
+// ABOUTME: Upstream starts every process at volume 100 and reports that to the server
+package main
+
+import (
+	"log"
+	"os"
+	"strconv"
+	"strings"
+	gosync "sync"
+	"time"
+
+	"github.com/Sendspin/sendspin-go/pkg/sendspin"
+)
+
+// persistVolume sets the initial volume from path (if it holds 0..100) and
+// wraps OnStateChange so later volume changes are written back, 3 s after
+// the last change (the file lives on a USB stick).
+func persistVolume(config *sendspin.PlayerConfig, path string) {
+	saved := config.Volume
+	if b, err := os.ReadFile(path); err == nil {
+		if v, err := strconv.Atoi(strings.TrimSpace(string(b))); err == nil && v >= 0 && v <= 100 {
+			if v == 0 {
+				v = 1 // NewPlayer treats 0 as "unset" and would start at 100
+			}
+			config.Volume, saved = v, v
+			log.Printf("Volume %d restored from %s", v, path)
+		}
+	}
+
+	var mu gosync.Mutex
+	var timer *time.Timer
+	pending := saved
+	write := func() {
+		mu.Lock()
+		v := pending
+		mu.Unlock()
+		tmp := path + ".tmp"
+		if err := os.WriteFile(tmp, []byte(strconv.Itoa(v)+"\n"), 0o644); err != nil {
+			log.Printf("Volume: save %s: %v", path, err)
+			return
+		}
+		if err := os.Rename(tmp, path); err != nil {
+			log.Printf("Volume: save %s: %v", path, err)
+		}
+	}
+
+	prev := config.OnStateChange
+	config.OnStateChange = func(state sendspin.PlayerState) {
+		if prev != nil {
+			prev(state)
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		if state.Volume == pending || state.Volume < 0 || state.Volume > 100 {
+			return
+		}
+		pending = state.Volume
+		if timer == nil {
+			timer = time.AfterFunc(3*time.Second, write)
+		} else {
+			timer.Reset(3 * time.Second)
+		}
+	}
+}
